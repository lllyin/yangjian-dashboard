# 告诉别的开发者/部署者需要创建 .env 并填入以下变量
YANGJIAN_ROOT=/path/to/your/yangjian
PORT=3000

# 数据源元数据检查的最短间隔（毫秒）。只限制文件指纹检查频率；
# 数据未变化时，计算结果会一直复用。允许范围 250-60000，默认 1000。
DATA_SOURCE_CHECK_INTERVAL_MS=1000

# 调试时可设为 1，在 API 响应中增加 X-Data-Cache: HIT/MISS。
# 生产环境建议保持关闭，避免公开数据更新时间侧信道。
DASHBOARD_CACHE_DEBUG=0

# Dashboard 完整数据访问 token（站长私有，不要泄漏）
# 留空则 /api/data 始终返回 403；公网访客只能访问 /api/public
# 访问示例：https://dashboard.example.com/?auth_token=your-secret-token-here
AUTH_TOKEN=your-secret-token-here
